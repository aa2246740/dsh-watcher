# Keep in sync with pnpm-workspace.yaml, pnpm-lock.yaml settings, and CI.
# pnpm 10 reads this file; pnpm 11+ reads pnpm-workspace.yaml instead. Without
# both, a plain or Dependabot `pnpm install` rewrites the lockfile with
# autoInstallPeers: true and `pnpm install --frozen-lockfile` fails with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
auto-install-peers=false
