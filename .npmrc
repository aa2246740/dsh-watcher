# Keep in sync with pnpm-workspace.yaml, pnpm-lock.yaml settings, and CI.
# The project pnpm is `packageManager` in package.json (pnpm 12), which reads
# pnpm-workspace.yaml and ignores this file. It stays for an older global pnpm
# that does not switch to the pinned version: without it, that pnpm rewrites
# the lockfile with autoInstallPeers: true and `pnpm install --frozen-lockfile`
# fails with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
auto-install-peers=false
