{
  "name": "dsh-watcher",
  "version": "0.8.0",
  "description": "Read-only DSH session insights and local model usage statistics",
  "type": "module",
  "main": "lib/dsh-watcher.js",
  "types": "lib/types/dsh-watcher.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/normalize-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.mjs",
    "test:list": "vitest list",
    "test:coverage": "tsc -p tsconfig.json && node scripts/run-tests.mjs --coverage",
    "deadcode": "knip",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "duplicates": "jscpd src tests scripts tools",
    "size": "size-limit",
    "check:todos": "node scripts/check-todos.mjs",
    "check:agents": "node scripts/check-agents-md.mjs",
    "prepare": "husky"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-watcher.d.ts",
      "default": "./lib/dsh-watcher.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "cordis.patch.yml",
    "pricing/**"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-watcher.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-watcher#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-watcher/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "watcher",
    "agent",
    "observability",
    "workflow",
    "plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session-stats": ">=0.2.0-rc.1 <0.2.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-stats": "0.2.0-rc.2",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.42.1",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^14.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": "eslint --max-warnings 0 --no-warn-ignored"
  }
}
