{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": false, "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src", "outDir": "lib/types", "esModuleInterop": true
  },
  "include": ["src"]
}
